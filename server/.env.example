PORT=5001

# --- Database: where enquiries are saved ---
# Local MongoDB:  mongodb://127.0.0.1:27017/netra-dynamics
# Atlas:          mongodb+srv://<user>:<password>@<cluster>.mongodb.net/netra-dynamics
MONGO_URI=mongodb://127.0.0.1:27017/netra-dynamics

# --- Email notification for every enquiry (optional but recommended) ---
# Gmail: turn on 2-step verification, then create an "App password" at
# https://myaccount.google.com/apppasswords and paste it below (not your normal password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=netradynamics@gmail.com
SMTP_PASS=
# Where notifications are sent (defaults to netradynamics@gmail.com)
MAIL_TO=netradynamics@gmail.com

# --- Only if the website and this API are hosted on different domains ---
# Comma-separated list of allowed website origins, e.g. https://www.yourdomain.com
CORS_ORIGIN=
