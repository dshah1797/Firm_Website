# Copy to .env.production (or set these in your host's dashboard) before building.

# Your live website address, no trailing slash. Used for share previews, sitemap.xml and robots.txt.
VITE_SITE_URL=https://www.yourdomain.com

# Only if the website and the API are on DIFFERENT domains (for example Vercel + Render).
# Leave empty when one Node server serves both (npm start).
VITE_API_URL=

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX. Leave empty to turn analytics off.
VITE_GA_ID=
